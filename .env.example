# Copier ce fichier vers .env puis renseigner uniquement les clés réellement utilisées.
# Ne jamais committer .env. Aucune valeur ci-dessous n'est une clé valide.

# Fournisseur de chat : openai, google, ollama ou fake.
# fake exécute des réponses scriptées, utiles pour les démonstrations hors ligne.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Modèle utilisé pour les requêtes jugées complexes par le middleware dynamic_model.
LLM_MODEL_ADVANCED=gpt-4o-mini

# Modèle de vision optionnel. Sans clé correspondante, le RAG documentaire
# passe explicitement en mode texte dégradé.
VISION_MODEL=gpt-4o-mini

OPENAI_API_KEY=
GOOGLE_API_KEY=

# Embeddings : hash (local, déterministe), openai ou google.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small

# Recherche web Tavily. Sans cette clé, web_search retourne une erreur explicite.
TAVILY_API_KEY=

# Traçage LangSmith, désactivé par défaut.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentic-ai-lab

# Serveurs MCP locaux en transport Streamable HTTP.
MCP_DEMO_HOST=127.0.0.1
MCP_DEMO_PORT=8000
MCP_DEMO_URL=http://127.0.0.1:8000/mcp
MCP_RAG_HOST=127.0.0.1
MCP_RAG_PORT=8001
MCP_RAG_URL=http://127.0.0.1:8001/mcp

# Mémoire persistante optionnelle des agents LangChain.
CHECKPOINT_PATH=data/checkpoints.sqlite

# Autorise uniquement les snippets arithmétiques de démonstration du REPL Python.
# Ne jamais activer cette option dans l'application web de support client.
AGENTIC_ALLOW_PYTHON_REPL=false
